---
const projects = [
  {
    title: "Flappy",
    tag: "Game · TypeScript",
    description:
      "Flappy Bird clone with a neuroevolution AI that learns to play on its own.",
    href: "/projects/flappy",
  },
];
---

<div class="grid">
  {
    projects.map((project) => (
      <a class="card" href={project.href}>
        <span class="card-tag">{project.tag}</span>
        <h3>{project.title}</h3>
        <p>{project.description}</p>
      </a>
    ))
  }
</div>
