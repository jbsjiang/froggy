{
  "name": "froggy",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev -w apps/site",
    "build": "npm run build -w apps/site",
    "preview": "npm run preview -w apps/site",
    "test": "npm test --workspaces --if-present",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0"
  }
}
